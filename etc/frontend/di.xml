<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        The live half of the section reads storefront price boxes, so its scripts are added
        in the frontend area only. Declared in etc/di.xml they would also be injected on admin
        pages, where view/frontend assets do not exist and the browser refuses the 404.
    -->
    <type name="Siteation\DebugBar\Model\ContributedSections">
        <arguments>
            <argument name="sections" xsi:type="array">
                <item name="c365" xsi:type="array">
                    <item name="scripts" xsi:type="array">
                        <!-- Before the theme's scripts, so the first price events are caught -->
                        <item name="head" xsi:type="array">
                            <item name="events" xsi:type="string">Siteation_Commerce365DebugBar::js/events.js</item>
                        </item>
                        <item name="body" xsi:type="array">
                            <item name="reader" xsi:type="string">Siteation_Commerce365DebugBar::js/section.js</item>
                        </item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
